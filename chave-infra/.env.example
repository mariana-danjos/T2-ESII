# ─── Ports ───────────────────────────────────────────────────────────────────
MS_AUTH_PORT=3001
MFE_AUTH_PORT=4001
SHELL_PORT=3000
MS_SUPPLIER_PORT=3002
MFE_SUPPLIER_PORT=4002

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── AWS / Ministack (LocalStack) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566

# ─── RDS (provisionado pelo Ministack via init.sh) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=chave
DB_PASSWORD=chave_secret
DB_NAME=chave_auth

# ─── Supplier Service ─────────────────────────────────────────────────────────
SUPPLIER_DB_PORT=5433
SUPPLIER_DB_USER=chave
SUPPLIER_DB_PASSWORD=chave_secret
SUPPLIER_DB_NAME=chave_supplier
RBAC_ENFORCE=false
SUPPLIER_EVENTS_ENABLED=false
SUPPLIER_SNS_TOPIC_ARN=
